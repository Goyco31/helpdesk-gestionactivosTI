# Copia este archivo como ".env" (en la carpeta backend) y completa los valores.
# ".env" esta en .gitignore: NUNCA lo subas a GitHub.

# Base de datos PostgreSQL en Azure
DB_URL=jdbc:postgresql://TU-SERVIDOR.postgres.database.azure.com:5432/postgres?sslmode=require
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_nueva_contrasena

# Gmail: usa una "contrasena de aplicacion" (no tu contrasena normal)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Clave de firma JWT en Base64 (minimo 32 bytes). Generar con: openssl rand -base64 48
JWT_SECRET=pega_aqui_la_clave_generada

# Opcionales
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHOW_SQL=false
